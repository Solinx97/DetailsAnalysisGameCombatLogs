{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Server": {
    "Identity": "https://localhost:7064/"
  },
  "BattleNet": {
    "BattleNetAutAPI": "https://oauth.battle.net/",
    "BattleNetAPI": "https://eu.api.blizzard.com/",
    "RedirectUri": "http://localhost:5173/wow-game-data/callback",
    "ClientId": "",
    "clientSecret": ""
  },
  "Cluster": {
    "CombatParser": "https://localhost:5001/",
    "User": "https://localhost:5003/",
    "Chat": "https://localhost:5007/",
    "Communication": "https://localhost:5009/",
    "Identity": "https://localhost:7064/",
    "Notification": "https://localhost:5244/"
  },
  "Authentication": {
    "CookieDomain": "localhost",
    "RedirectUri": "http://localhost:5173/callback",
    "CancelUri": "http://localhost:5173/",
    "IdentityAuthPath": "authorization",
    "IdentityRegistryPath": "registration",
    "CodeChallengeMethod": "SHA-256",
    "RefreshTokenExpiresSec": 2592000,
    "GrantType": {
      "Code": "code",
      "Authorization": "authorizationCode",
      "RefreshToken": "refreshToken"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "personal-chat-hub": {
        "ClusterId": "chat-api",
        "Match": {
          "Path": "/personalChatHub/{**catch-all}"
        }
      },
      "personal-chat-mesages-hub": {
        "ClusterId": "chat-api",
        "Match": {
          "Path": "/personalChatMessagesHub/{**catch-all}"
        }
      },
      "personal-chat-unread-mesages-hub": {
        "ClusterId": "chat-api",
        "Match": {
          "Path": "/personalChatUnreadMessagesHub/{**catch-all}"
        }
      },
      "group-chat-hub": {
        "ClusterId": "chat-api",
        "Match": {
          "Path": "/groupChatHub/{**catch-all}"
        }
      },
      "groupl-chat-mesages-hub": {
        "ClusterId": "chat-api",
        "Match": {
          "Path": "/groupChatMessagesHub/{**catch-all}"
        }
      },
      "groupl-chat-unread-mesages-hub": {
        "ClusterId": "chat-api",
        "Match": {
          "Path": "/groupChatUnreadMessagesHub/{**catch-all}"
        }
      },
      "notification-hub": {
        "ClusterId": "notification-api",
        "Match": {
          "Path": "/notificationHub/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "chat-api": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5007"
          }
        }
      },
      "notification-api": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5244"
          }
        }
      }
    }
  }
}
