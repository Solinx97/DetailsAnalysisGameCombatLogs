<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CombatAnalysis.UploadingLogsApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CombatAnalysis.UploadingLogsApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CombatAnalysis.UploadingLogsApp">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <ContentControl Content="{Binding NavigationStore.CurrentViewModel}" />
</Window>
