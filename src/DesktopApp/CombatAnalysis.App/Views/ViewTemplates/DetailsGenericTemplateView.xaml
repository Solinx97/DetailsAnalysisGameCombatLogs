<views:MvxWpfView 
    x:Class="CombatAnalysis.App.Views.ViewTemplates.DetailsGenericTemplateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:convertersCombat="clr-namespace:CombatAnalysis.App.Converters.CombatLogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:CombatAnalysis.App.Converters"
    xmlns:loc="clr-namespace:CombatAnalysis.App.Localizations"
    xmlns:resx="clr-namespace:CombatAnalysis.App.Localizations.Resources.DetailsGeneric"
    xmlns:local="clr-namespace:CombatAnalysis.App.Views.ViewTemplates"
    xmlns:basicViewModel="clr-namespace:CombatAnalysis.Core.ViewModels.ViewModelTemplates;assembly=CombatAnalysis.Core"
    xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
    xmlns:vm="clr-namespace:CombatAnalysis.Core.ViewModels.Details;assembly=CombatAnalysis.Core"
    xmlns:viewsDetails="clr-namespace:CombatAnalysis.App.Views.Details"
    loc:LocalizationObject.ResourceManager="{x:Static resx:Resource.ResourceManager}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.15*"/>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.15*"/>
            <RowDefinition Height="0.15*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55"/>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <converters:TheNativeBoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:TheNativeIntToVisibilityConverter x:Key="IntToVisibility" />
            <convertersCombat:IntToEnhancedIntConverter x:Key="IntToEnhancedInt" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />

            <DataTemplate DataType="{x:Type vm:DamageDoneViewModel}">
                <viewsDetails:DamageDoneView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:HealDoneViewModel}">
                <viewsDetails:HealDoneView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DamageTakenViewModel}">
                <viewsDetails:DamageTakenView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ResourceRecoveryViewModel}">
                <viewsDetails:ResourceRecoveryView />
            </DataTemplate>
        </Grid.Resources>

        <ContentControl Grid.ColumnSpan="3" Grid.RowSpan="5" Content="{Binding Basic}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type basicViewModel:BasicTemplateViewModel}">
                    <local:BasicTemplateView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>

        <Grid Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Margin="20" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                   Text="{Binding SelectedPlayer}" FontSize="18" Foreground="White"
                   FontWeight="Bold" FontFamily="Comic Sans MS" TextAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Panel.ZIndex="1">
            <StackPanel Orientation="Horizontal" Visibility="{Binding LoadingStatus, Converter={StaticResource IntToVisibility}, ConverterParameter='true:2:='}">
                <TextBlock Text="{loc:Loc TypeOf}" FontSize="15" TextAlignment="Center" Padding="10" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0" Width="100" Foreground="White"/>
                <ComboBox Style="{DynamicResource ComboBoxStyle1}" VerticalAlignment="Center" Name="detailsType"
                          Width="135" SelectedIndex="{Binding DetailsTypeSelectedIndex}">
                    <ComboBoxItem Content="{loc:Loc Common}" IsSelected="True"/>
                    <ComboBoxItem Content="{loc:Loc MoreDetails}" />
                </ComboBox>
            </StackPanel>

            <TextBlock Text="{loc:Loc Loading}" HorizontalAlignment="Center" Margin="0 10" Foreground="White" FontSize="15"
                       Visibility="{Binding LoadingStatus, Converter={StaticResource IntToVisibility}, ConverterParameter='true:1:='}">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeLoadingStoryboard}" />
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{loc:Loc Title}"
                       Width="350" TextAlignment="Center" Style="{StaticResource titleText}" Foreground="White" Margin="25 0"/>
        </StackPanel>

        <Grid Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" Visibility="{Binding DetailsTypeSelectedIndex, Converter={StaticResource IntToVisibility}, ConverterParameter=true:1}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Creators.Count, Converter={StaticResource IntToVisibility}, ConverterParameter='false:0:>'}">
                <TextBlock Text="{loc:Loc Creator}" FontSize="15" TextAlignment="Center" Padding="10" FontWeight="SemiBold"
                           Margin="0" Width="100" Foreground="White"/>
                <ComboBox Style="{DynamicResource ComboBoxStyle1}" ItemsSource="{Binding Creators}"
                          VerticalAlignment="Center" SelectedItem="{Binding SelectedCreator}" SelectedIndex="0"/>
            </StackPanel>
            
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Targets.Count, Converter={StaticResource IntToVisibility}, ConverterParameter='false:0:>'}">
                <TextBlock Text="{loc:Loc Target}" FontSize="15" TextAlignment="Center" Padding="10" FontWeight="SemiBold"
                           Margin="0" Width="100" Foreground="White"/>
                <ComboBox Style="{DynamicResource ComboBoxStyle1}" ItemsSource="{Binding Targets}"
                          VerticalAlignment="Center" SelectedItem="{Binding SelectedTarget}" SelectedIndex="0"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{loc:Loc Spell}" FontSize="15" TextAlignment="Center" Padding="10" FontWeight="SemiBold"
                           Margin="0" Width="100" Foreground="White"/>
                <ComboBox Style="{DynamicResource ComboBoxStyle1}" ItemsSource="{Binding Spells}"
                          VerticalAlignment="Center" SelectedItem="{Binding SelectedSpell}" SelectedIndex="0"/>
            </StackPanel>
        </Grid>

        <ContentControl Grid.ColumnSpan="3" Grid.RowSpan="5" Content="{Binding CurrentView}" />

        <StackPanel Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
            <TextBlock Margin="15 0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"
                   Text="{loc:Loc Total}" FontSize="16" TextAlignment="Center"/>
            <TextBlock Margin="15 0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"
                   Text="{Binding TotalValue}" FontSize="18" TextAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal"
                    Visibility="{Binding ElementName=detailsType, Path=SelectedIndex, Converter={StaticResource IntToVisibility}, ConverterParameter=true:1}">
            <StackPanel Margin="0 0" Orientation="Horizontal">
                <TextBlock Foreground="White" Text="{loc:Loc First}" FontSize="12">
                    <TextBlock.InputBindings>
                        <MouseBinding Command="{Binding FirstPageCommand}" Gesture="LeftClick"/>
                    </TextBlock.InputBindings>
                </TextBlock>
                <TextBlock Margin="15 0" Foreground="White" Text="{loc:Loc Prev}" FontSize="12" Cursor="Hand">
                    <TextBlock.InputBindings>
                        <MouseBinding Command="{Binding PrevPageCommand}" Gesture="LeftClick"/>
                    </TextBlock.InputBindings>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" Text="{Binding Page}" FontSize="12" />
                <TextBlock Margin="5 0" Foreground="White" Text="/" FontSize="12" />
                <TextBlock Foreground="White" Text="{Binding MaxPages}" FontSize="12" />
            </StackPanel>
            <StackPanel Margin="15 0 20 0" Orientation="Horizontal">
                <TextBlock Foreground="White" Text="{loc:Loc Next}" FontSize="12">
                    <TextBlock.InputBindings>
                        <MouseBinding Command="{Binding NextPageCommand}" Gesture="LeftClick"/>
                    </TextBlock.InputBindings>
                </TextBlock>
                <TextBlock Margin="15 0" Foreground="White" Text="{loc:Loc Last}" FontSize="12">
                    <TextBlock.InputBindings>
                        <MouseBinding Command="{Binding LastPageCommand}" Gesture="LeftClick"/>
                    </TextBlock.InputBindings>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</views:MvxWpfView>
